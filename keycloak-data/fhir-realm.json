{
  "realm": "fhir",
  "loginTheme": "keycloak",
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-ancestors 'self' https://localhost:9009 https://localhost:8085 https://localhost:8180;"
  },
  "enabled": true,
  "clients": [
    {
      "clientId": "hapi-fhir-client",
      "secret": "hapi-secret",
      "enabled": true,
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://localhost:8083/*",
        "https://localhost:8180/*"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "fhir-smart-scopes"
      ]
    },
    {
      "clientId": "smart_cds_platform",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "clientAuthenticatorType": "none",
      "redirectUris": [
        "https://localhost:8085/index.html",
        "https://localhost:8085/launch.html",
        "https://localhost:9009/*"
      ],
      "webOrigins": [
        "https://localhost:8085",
        "https://localhost:9009"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "fhir-smart-scopes",
        "launch",
        "fhirUser"
      ]
    },
    {
      "clientId": "smart-launcher-client",
      "secret": "launcher-secret",
      "enabled": true,
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://localhost:9009/*"
      ],
      "webOrigins": [
        "https://localhost:9009"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "openid",
      "protocol": "openid-connect"
    },
    {
      "name": "profile",
      "protocol": "openid-connect"
    },
    {
      "name": "email",
      "protocol": "openid-connect"
    },
    {
      "name": "launch",
      "description": "SMART launch scope",
      "protocol": "openid-connect"
    },
    {
      "name": "fhirUser",
      "description": "FHIR User identity scope",
      "protocol": "openid-connect"
    },
    {
      "name": "fhir-smart-scopes",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "smart_cds_platform",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "fhirUser",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "fhirUser",
            "claim.value": "Practitioner/fhir-admin",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "launch-context",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "launch",
            "claim.value": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "fhir-admin",
      "enabled": true,
      "emailVerified": true,
      "attributes": {},
      "credentials": [
        {
          "type": "password",
          "value": "fhir-admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "offline_access",
        "uma_authorization"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "fhir-user"
      }
    ]
  }
}