{
  "realm": "fhir",
  "loginTheme": "keycloak",
  "enabled": true,
  "clients": [
    {
      "clientId": "hapi-fhir-client",
      "secret": "hapi-secret",
      "enabled": true,
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "*"
      ]
    },
    {
      "clientId": "smart_cds_platform",
      "enabled": true,
      "publicClient": true,     
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "clientAuthenticatorType": "none", 
      "redirectUris": ["http://localhost:8085/*", "http://localhost:9009/*"],
      "webOrigins": ["*"],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "fhir-smart-scopes"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "smart-launcher-client",
      "secret": "launcher-secret",
      "enabled": true,
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:9009/*"
      ],
      "webOrigins": [
        "http://localhost:9009"
      ]
    }
  ],
  
  "clientScopes": [
    {
      "name": "openid",  
      "protocol": "openid-connect"
    },
    {
      "name": "profile",  
      "protocol": "openid-connect"
    },
    {
      "name": "email",  
      "protocol": "openid-connect"
    },
    {
      "name": "fhir-smart-scopes",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "launch",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "launch",
            "claim.value": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "fhirUser",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "fhirUser",
            "claim.value": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "patient/*.read",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "patient/*.read",
            "claim.value": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "encounter/*.read",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "encounter/*.read",
            "claim.value": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "observation/*.read",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "observation/*.read",
            "claim.value": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "condition/*.read",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "condition/*.read",
            "claim.value": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "medicationrequest/*.read",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "medicationrequest/*.read",
            "claim.value": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "procedure/*.read",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "procedure/*.read",
            "claim.value": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  
  "users": [
    {
      "username": "fhir-admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "fhir-admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "offline_access",
        "uma_authorization"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "fhir-user"
      }
    ]
  }
}