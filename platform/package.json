    "http-server": "^14.1.1"
  },
  "dependencies": {
    "fhirclient": "^2.5.2"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/cds-playground.git"
  },
