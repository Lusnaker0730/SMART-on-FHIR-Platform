{
  "name": "CDS Playground - 臨床決策支持平台",
  "description": "基於 SMART on FHIR 的臨床決策支持平台，提供 CDS Hooks 整合和風險評估工具",
  "version": "1.0.0",
  "author": "CDS Platform Team",
  "fhir_versions": ["4.0.1", "4.0.0", "3.0.1"],
  "launch": {
    "launch_uri": "./launch.html",
    "redirect_uris": ["./index.html"]
  },
  "scopes": [
    "launch",
    "openid", 
    "fhirUser",
    "patient/*.read",
    "encounter/*.read",
    "observation/*.read",
    "condition/*.read",
    "medicationrequest/*.read",
    "procedure/*.read",
    "diagnosticreport/*.read",
    "medication/*.read",
    "allergyintolerance/*.read"
  ],
  "client_id": "smart_cds_platform",
  "features": {
    "cds_hooks": {
      "enabled": true,
      "supported_hooks": [
        "patient-view",
        "medication-prescribe", 
        "order-review",
        "encounter-start",
        "encounter-discharge"
      ]
    },
    "standalone_launch": true,
    "ehr_launch": true,
    "patient_context_required": true
  },
  "icons": {
    "small": "./favicon-16x16.png",
    "large": "./favicon-32x32.png"
  },
  "categories": [
    "Clinical Decision Support",
    "Risk Assessment",
    "Quality Improvement"
  ],
  "contact": {
    "email": "support@example.com",
    "url": "https://github.com/your-username/cds-playground"
  }
} 